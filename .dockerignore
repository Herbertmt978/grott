/.git
/.github
/.pytest_cache
/.venv*
**/__pycache__
**/*.pyc
/docs
/tests
/wiki
/documentatie

# Package only reviewed external layouts. The examples directory contains
# alternative definitions that are not safe to auto-load together.
/examples/Record Layout/*
!/examples/Record Layout/T06NNNNXMOD.json
!/examples/Record Layout/t060103xmax3.json
!/examples/Record Layout/T06221b.json

# Local operator configuration and environment files must never enter BuildKit.
**/grott.ini
!/examples/grott.ini
**/.env
**/.env.*
!/.env.example

# Captures, logs, private keys, and common local credential exports.
**/*.pcap
**/*.pcapng
**/*.cap
**/*.log
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/id_rsa*
**/credentials*.json
**/secrets*.yaml
**/secrets*.yml
**/*.secret
**/*.credentials
